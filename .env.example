# =============================================================================
# ACE Gateway Backend - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit the actual .env file to version control.
#
#   cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase configuration
# Required for JWT authentication on all protected endpoints.
# -----------------------------------------------------------------------------

# The URL of your Supabase project (no trailing slash)
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Publishable / anon key (safe to expose to browsers)
SUPABASE_PUBLISHABLE_KEY=eyJ...

# Service-role secret key (never expose publicly)
SUPABASE_SECRET_KEY=eyJ...

# JWT secret used to sign tokens when Supabase uses HS256 (symmetric) signing.
# Leave empty if your project uses RS256 (asymmetric) and JWKS instead.
SUPABASE_JWT_SECRET=

# Audience claim expected in JWTs (default: "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated

# Set to "false" to skip audience / issuer verification in development
SUPABASE_VERIFY_AUDIENCE=true
SUPABASE_VERIFY_ISSUER=true

# How long (in seconds) to cache the Supabase JWKS response (default: 300)
SUPABASE_JWKS_CACHE_SECONDS=300


# -----------------------------------------------------------------------------
# FastAPI server
# -----------------------------------------------------------------------------

API_HOST=127.0.0.1
API_PORT=8000


# -----------------------------------------------------------------------------
# Local upstream settings
# The gateway and ACE runtime live on the same VPS/host.
# -----------------------------------------------------------------------------

ACE_UPSTREAM_SCHEME=http
ACE_UPSTREAM_HOST=127.0.0.1
ACE_UPSTREAM_PORT=7777
ACE_UPSTREAM_BASE_PATH=


# -----------------------------------------------------------------------------
# Per-user runtime orchestration (Docker on VPS)
# -----------------------------------------------------------------------------

# Docker network where per-user containers run.
ACE_DOCKER_NETWORK=ace-net

# Runtime image (tag optional when not embedded in image name).
ACE_RUNTIME_IMAGE=ace-hermes
ACE_RUNTIME_IMAGE_TAG=latest

# User-container contract
ACE_RUNTIME_CONTAINER_PORT=8080
ACE_RUNTIME_READINESS_PATH=/readyz
ACE_RUNTIME_DATA_MOUNT=/data/ace
ACE_RUNTIME_SKILLS_MOUNT=/global_skills
ACE_GLOBAL_SKILLS_DIR=/opt/ace/skills/current

# Provisioning behavior
ACE_RUNTIME_READY_TIMEOUT_SECONDS=25
ACE_RUNTIME_READY_POLL_SECONDS=0.5
ACE_RUNTIME_LOG_TAIL_LINES=200
ACE_RUNTIME_CACHE_SECONDS=10

# Optional: when true, concurrent provisioning requests can return 409 instead
# of waiting for the in-flight user lock to complete.
ACE_RUNTIME_LOCK_CONFLICT_RETURNS_409=false

# -----------------------------------------------------------------------------
# Control plane / manager
# -----------------------------------------------------------------------------

ACE_INTERNAL_API_TOKEN=replace-me
ACE_BIND_HOST=0.0.0.0
ACE_BIND_PORT=8100
ACE_AGENT_INTERNAL_PORT=8080
ACE_AGENT_DATA_MOUNT=/data/ace
ACE_DEFAULT_IMAGE_TAG=ace-agent:latest
ACE_PRESERVE_FAILED_CONTAINERS=true

# -----------------------------------------------------------------------------
# Messaging ingress
# -----------------------------------------------------------------------------

PUBLIC_BASE_URL=https://gateway.example.com
TWILIO_AUTH_TOKEN=
LINQ_WEBHOOK_TOKEN=
LINQ_REPLY_URL=
LINQ_API_KEY=
LINQ_API_KEY_HEADER=Authorization
